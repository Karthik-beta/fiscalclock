{
  "name": "runtime-out-of-range-nrf",
  "description": "The days just outside the first (1) and last (9998) NRF fiscal years that lie wholly in the supported range. dimension reports OUT_OF_RANGE at start when the fiscal year of start is out of range, otherwise at end_exclusive.",
  "source": {
    "kind": "errors",
    "citation": "spec/api-v1.md error catalogue and conventions; expected values computed by conformance/generators/fiscal_oracle.py",
    "url": null,
    "checked_by": "Manual reading of spec/definition-v1.md and spec/api-v1.md, 2026-10-31"
  },
  "definition": {
    "spec_version": 1,
    "year": {
      "type": "week_based",
      "anchor": {
        "edge": "end",
        "month": 1,
        "day": "last",
        "rule": "nearest"
      }
    },
    "week": {
      "starts_on": "sunday",
      "numbering": "contains_start"
    },
    "subdivision": {
      "type": "week_pattern",
      "periods": [
        4,
        5,
        4,
        4,
        5,
        4,
        4,
        5,
        4,
        4,
        5,
        4
      ],
      "quarters": [
        3,
        3,
        3,
        3
      ],
      "extra_week": {
        "period": 12
      }
    },
    "naming": {
      "default": "nrf",
      "schemes": {
        "nrf": {
          "year_number": "start",
          "templates": {
            "year": "FY{yyyy}",
            "quarter": "FY{yyyy} Q{q}",
            "period": "FY{yyyy} P{pp}",
            "week": "FY{yyyy} W{ww}"
          }
        }
      }
    }
  },
  "cases": [
    {
      "op": "validate",
      "args": {},
      "expect": {
        "ok": true,
        "calendar_id": "efc8868a4b19eaab",
        "canonical": "{\"naming\":{\"default\":\"nrf\",\"schemes\":{\"nrf\":{\"century_pivot\":null,\"offset\":0,\"templates\":{\"period\":\"FY{yyyy} P{pp}\",\"quarter\":\"FY{yyyy} Q{q}\",\"week\":\"FY{yyyy} W{ww}\",\"year\":\"FY{yyyy}\"},\"year_number\":\"start\"}}},\"spec_version\":1,\"subdivision\":{\"extra_week\":{\"period\":12},\"periods\":[4,5,4,4,5,4,4,5,4,4,5,4],\"quarters\":[3,3,3,3],\"type\":\"week_pattern\"},\"week\":{\"numbering\":\"contains_start\",\"starts_on\":\"sunday\"},\"year\":{\"anchor\":{\"day\":\"last\",\"edge\":\"end\",\"month\":1,\"rule\":\"nearest\"},\"type\":\"week_based\"}}"
      }
    },
    {
      "op": "locate",
      "args": {
        "date": "0001-02-03"
      },
      "expect_error": {
        "code": "OUT_OF_RANGE",
        "path": "date"
      }
    },
    {
      "op": "locate",
      "args": {
        "date": "9999-01-31"
      },
      "expect_error": {
        "code": "OUT_OF_RANGE",
        "path": "date"
      }
    },
    {
      "op": "period",
      "args": {
        "level": "year",
        "year": 0
      },
      "expect_error": {
        "code": "OUT_OF_RANGE",
        "path": "year"
      }
    },
    {
      "op": "period",
      "args": {
        "level": "year",
        "year": 9999
      },
      "expect_error": {
        "code": "OUT_OF_RANGE",
        "path": "year"
      }
    },
    {
      "op": "shift",
      "args": {
        "period": {
          "level": "week",
          "year": 9998,
          "index": 1
        },
        "n": 60
      },
      "expect_error": {
        "code": "OUT_OF_RANGE",
        "path": "n"
      }
    },
    {
      "op": "dimension",
      "args": {
        "start": "0001-02-03",
        "end_exclusive": "0001-02-05"
      },
      "expect_error": {
        "code": "OUT_OF_RANGE",
        "path": "start"
      }
    },
    {
      "op": "dimension",
      "args": {
        "start": "9999-01-30",
        "end_exclusive": "9999-02-01"
      },
      "expect_error": {
        "code": "OUT_OF_RANGE",
        "path": "end_exclusive"
      }
    },
    {
      "op": "dimension",
      "args": {
        "start": "9999-01-31",
        "end_exclusive": "9999-02-01"
      },
      "expect_error": {
        "code": "OUT_OF_RANGE",
        "path": "start"
      }
    }
  ]
}
