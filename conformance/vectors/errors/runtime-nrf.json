{
  "name": "runtime-nrf",
  "description": "Runtime errors on the NRF 4-5-4 definition: malformed dates (including year 0000, a time suffix and a zone suffix), missing periods, bad arguments, unknown scheme, unrecognised labels, and dimension ranges with start after end_exclusive or longer than 146,097 days (INVALID_ARGUMENT at end_exclusive, from the api-v1.md table \"Paths for common errors\").",
  "source": {
    "kind": "errors",
    "citation": "spec/api-v1.md error catalogue and conventions; expected values computed by conformance/generators/fiscal_oracle.py",
    "url": "https://github.com/Karthik-beta/fiscalclock/blob/main/spec/api-v1.md#error-catalogue",
    "checked_by": "Manual reading of spec/api-v1.md, 2026-10-31; conformance/generators/fiscal_oracle.py computes each case and the generator asserts that its error code equals the one read from the spec"
  },
  "definition": {
    "spec_version": 1,
    "year": {
      "type": "week_based",
      "anchor": {
        "edge": "end",
        "month": 1,
        "day": "last",
        "rule": "nearest"
      }
    },
    "week": {
      "starts_on": "sunday",
      "numbering": "contains_start"
    },
    "subdivision": {
      "type": "week_pattern",
      "periods": [
        4,
        5,
        4,
        4,
        5,
        4,
        4,
        5,
        4,
        4,
        5,
        4
      ],
      "quarters": [
        3,
        3,
        3,
        3
      ],
      "extra_week": {
        "period": 12
      }
    },
    "naming": {
      "default": "nrf",
      "schemes": {
        "nrf": {
          "year_number": "start",
          "templates": {
            "year": "FY{yyyy}",
            "quarter": "FY{yyyy} Q{q}",
            "period": "FY{yyyy} P{pp}",
            "week": "FY{yyyy} W{ww}"
          }
        }
      }
    }
  },
  "cases": [
    {
      "op": "validate",
      "args": {},
      "expect": {
        "ok": true,
        "calendar_id": "efc8868a4b19eaab",
        "canonical": "{\"naming\":{\"default\":\"nrf\",\"schemes\":{\"nrf\":{\"century_pivot\":null,\"offset\":0,\"templates\":{\"period\":\"FY{yyyy} P{pp}\",\"quarter\":\"FY{yyyy} Q{q}\",\"week\":\"FY{yyyy} W{ww}\",\"year\":\"FY{yyyy}\"},\"year_number\":\"start\"}}},\"spec_version\":1,\"subdivision\":{\"extra_week\":{\"period\":12},\"periods\":[4,5,4,4,5,4,4,5,4,4,5,4],\"quarters\":[3,3,3,3],\"type\":\"week_pattern\"},\"week\":{\"numbering\":\"contains_start\",\"starts_on\":\"sunday\"},\"year\":{\"anchor\":{\"day\":\"last\",\"edge\":\"end\",\"month\":1,\"rule\":\"nearest\"},\"type\":\"week_based\"}}"
      }
    },
    {
