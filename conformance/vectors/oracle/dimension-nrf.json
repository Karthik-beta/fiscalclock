{
  "name": "dimension-nrf",
  "description": "Date dimension rows for 10 days across the end of NRF fiscal 2023 (a 53-week year) into fiscal 2024, as JSON rows and as CSV. A second scheme 'retail' has a quarter template with a comma and double quotes, so the CSV must quote and double them. An empty range (start equal to end_exclusive) gives [] as JSON, and as CSV the header row alone (reading: the header row is always written).",
  "source": {
    "kind": "oracle",
    "citation": "Independent implementation of the spec in conformance/generators/fiscal_oracle.py, written with Python datetime and no fiscalclock code",
    "url": null,
    "checked_by": "fiscal_oracle.py; CSV quoting per RFC 4180 as specified"
  },
