        "nrf": {
          "year_number": "start",
          "templates": {
            "year": "FY{yyyy}",
            "quarter": "FY{yyyy} Q{q}",
            "period": "FY{yyyy} P{pp}",
            "week": "FY{yyyy} W{ww}"
          }
        },
        "retail": {
          "year_number": "start",
          "templates": {
            "quarter": "Q{q}, \"{yyyy}\""
          }
        }
      }
    }
  },
