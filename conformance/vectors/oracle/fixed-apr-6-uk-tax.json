{
  "name": "fixed-apr-6-uk-tax",
  "description": "UK tax year style: starts 6 April, fiscal months start on the 6th (month_start_day 6), named by start year ('2024-25'). Weeks use contains_start: week 1 runs from the year's first day to the day before the next week start (7 days when the year starts on the week-start weekday), and day_of_week counts from the weekday, so a partial week can begin on a day_of_week other than 1.",
  "source": {
    "kind": "oracle",
    "citation": "Independent implementation of the spec in conformance/generators/fiscal_oracle.py, written with Python datetime and no fiscalclock code",
    "url": null,
    "checked_by": "fiscal_oracle.py; leap-year bounds hand-checked 2026-10-31"
  },
  "definition": {
    "spec_version": 1,
    "year": {
      "type": "fixed_date",
      "start": {
        "month": 4,
        "day": 6
      }
    },
    "week": {
      "starts_on": "monday",
      "numbering": "contains_start"
    },
    "subdivision": {
      "type": "calendar_months",
      "month_start_day": 6,
      "quarters": [
        3,
        3,
        3,
        3
      ]
    },
    "naming": {
      "default": "tax",
      "schemes": {
        "tax": {
          "year_number": "start",
          "templates": {
            "year": "{yyyy}-{yy_next}",
            "period": "{yyyy}-{yy_next} M{pp}"
          }
        }
      }
    }
  },
