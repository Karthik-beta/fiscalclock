{
  "name": "fixed-oct-1-us-federal",
  "description": "US federal style fiscal year starting 1 October, named by end year (FY2024 is 1 Oct 2023 to 30 Sep 2024), weeks start Sunday. Weeks use contains_start: week 1 runs from the year's first day to the day before the next week start (7 days when the year starts on the week-start weekday), and day_of_week counts from the weekday, so a partial week can begin on a day_of_week other than 1.",
  "source": {
    "kind": "oracle",
    "citation": "Independent implementation of the spec in conformance/generators/fiscal_oracle.py, written with Python datetime and no fiscalclock code",
    "url": null,
    "checked_by": "fiscal_oracle.py; leap-year bounds hand-checked 2026-10-31"
  },
  "definition": {
    "spec_version": 1,
    "year": {
      "type": "fixed_date",
      "start": {
        "month": 10,
        "day": 1
      }
    },
    "week": {
      "starts_on": "sunday",
      "numbering": "contains_start"
    },
    "subdivision": {
      "type": "calendar_months",
      "month_start_day": 1,
      "quarters": [
        3,
        3,
        3,
        3
      ]
    },
    "naming": {
      "default": "fy",
      "schemes": {
        "fy": {
          "year_number": "end",
          "templates": {
            "year": "FY{yyyy}",
            "quarter": "FY{yyyy} Q{q}"
          }
        }
      }
    }
  },
