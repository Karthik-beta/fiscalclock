{
  "name": "labels-range-before-checks",
  "description": "parse checks the range of the year a label names before the two-digit year checks. Fiscal years start 1 April and are numbered by start year, so the supported numbers are 1 to 9998 (fiscal 9999 would end in 10000). Scheme 'fy' is {yyyy}-{yy_next}: '0000-05' names year 0, which is out of range, so it is OUT_OF_RANGE although {yy_next} also disagrees (fiscalclock 0.1.0 returned LABEL_NOT_RECOGNISED). Scheme 'short' is {yy}-{yy_next} with century_pivot 9999, so '99' resolves to 9999 (the pivot window is 9900-9999): '99-05' and '99-00' are OUT_OF_RANGE whether or not {yy_next} agrees, and '98-99' is fiscal 9998. Scheme 'slash' is {yyyy}/{yy}: '0000/01' is OUT_OF_RANGE, '2024/25' names an in-range year whose {yy} disagrees with {yyyy}, so it is LABEL_NOT_RECOGNISED, and '2024/24' is fiscal 2024.",
  "source": {
    "kind": "oracle",
    "citation": "Independent implementation of the spec in conformance/generators/fiscal_oracle.py, written with Python datetime and no fiscalclock code",
    "url": null,
    "checked_by": "fiscal_oracle.py parse"
  },
  "definition": {
    "spec_version": 1,
    "year": {
      "type": "fixed_date",
      "start": {
        "month": 4,
        "day": 1
      }
    },
    "week": {
      "starts_on": "monday",
      "numbering": "contains_start"
    },
    "subdivision": {
      "type": "calendar_months",
      "month_start_day": 1,
      "quarters": [
        3,
        3,
        3,
        3
      ]
    },
    "naming": {
      "default": "fy",
      "schemes": {
        "fy": {
          "year_number": "start",
          "templates": {
            "year": "{yyyy}-{yy_next}"
          }
        },
        "short": {
          "year_number": "start",
          "century_pivot": 9999,
          "templates": {
            "year": "{yy}-{yy_next}"
          }
        },
        "slash": {
          "year_number": "start",
          "templates": {
            "year": "{yyyy}/{yy}"
          }
        }
      }
    }
  },
  "cases": [
    {
      "op": "validate",
      "args": {},
      "expect": {
        "ok": true,
        "calendar_id": "6973877b01a7f6ed",
        "canonical": "{\"naming\":{\"default\":\"fy\",\"schemes\":{\"fy\":{\"century_pivot\":null,\"offset\":0,\"templates\":{\"year\":\"{yyyy}-{yy_next}\"},\"year_number\":\"start\"},\"short\":{\"century_pivot\":9999,\"offset\":0,\"templates\":{\"year\":\"{yy}-{yy_next}\"},\"year_number\":\"start\"},\"slash\":{\"century_pivot\":null,\"offset\":0,\"templates\":{\"year\":\"{yyyy}/{yy}\"},\"year_number\":\"start\"}}},\"spec_version\":1,\"subdivision\":{\"month_start_day\":1,\"quarters\":[3,3,3,3],\"type\":\"calendar_months\"},\"week\":{\"numbering\":\"contains_start\",\"starts_on\":\"monday\"},\"year\":{\"short_month\":null,\"start\":{\"day\":1,\"month\":4},\"type\":\"fixed_date\"}}"
      }
    },
    {
      "op": "parse",
      "args": {
        "label": "0000-05"
      },
      "expect_error": {
        "code": "OUT_OF_RANGE",
        "path": "label"
      }
    },
    {
      "op": "parse",
      "args": {
        "label": "0000-01"
      },
      "expect_error": {
        "code": "OUT_OF_RANGE",
        "path": "label"
      }
    },
    {
      "op": "parse",
      "args": {
        "label": "99-05"
      },
      "expect_error": {
        "code": "OUT_OF_RANGE",
        "path": "label"
      }
    },
    {
      "op": "parse",
      "args": {
        "label": "99-00"
      },
      "expect_error": {
        "code": "OUT_OF_RANGE",
        "path": "label"
      }
    },
    {
      "op": "parse",
      "args": {
        "label": "98-99"
      },
      "expect": {
        "level": "year",
        "year": 9998,
        "index": null,
        "start": "9998-04-01",
        "end_exclusive": "9999-04-01",
        "last_day": "9999-03-31",
        "days": 365,
        "weeks": null,
        "has_extra_week": false
      }
    },
    {
      "op": "parse",
      "args": {
        "label": "0000/01"
      },
      "expect_error": {
        "code": "OUT_OF_RANGE",
        "path": "label"
      }
    },
    {
      "op": "parse",
      "args": {
        "label": "2024/25"
      },
      "expect_error": {
        "code": "LABEL_NOT_RECOGNISED",
        "path": "label"
      }
    },
    {
      "op": "parse",
      "args": {
        "label": "2024/24"
      },
      "expect": {
        "level": "year",
        "year": 2024,
        "index": null,
        "start": "2024-04-01",
        "end_exclusive": "2025-04-01",
        "last_day": "2025-03-31",
        "days": 365,
        "weeks": null,
        "has_extra_week": false
      }
    }
  ]
}
