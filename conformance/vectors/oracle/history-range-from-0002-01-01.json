{
  "name": "history-range-from-0002-01-01",
  "description": "A history entry whose from is 0002-01-01, the earliest date allowed in exceptions, and a year start of both the previous rule and its own (1 January; the entry changes the quarters to three of 4 months). It is accepted. Regime 0 has no fiscal year in the supported range, so the first supported year, 2, has three quarters. Illustrative.",
  "source": {
    "kind": "oracle",
    "citation": "Independent implementation of the spec in conformance/generators/fiscal_oracle.py, written with Python datetime and no fiscalclock code",
    "url": null,
    "checked_by": "fiscal_oracle.py: Calendar.seq built from the regimes and transitions; change_errors and naming_errors pass"
  },
  "definition": {
    "spec_version": 1,
    "year": {
      "type": "fixed_date",
      "start": {
        "month": 1,
        "day": 1
      }
    },
    "week": {
      "starts_on": "monday",
      "numbering": "contains_start"
    },
    "subdivision": {
      "type": "calendar_months",
      "month_start_day": 1,
      "quarters": [
        3,
        3,
        3,
        3
      ]
    },
    "naming": {
      "default": "fy",
      "schemes": {
        "fy": {
          "year_number": "start",
          "templates": {
            "year": "FY{yyyy}",
            "quarter": "FY{yyyy} Q{q}"
          }
        }
      }
    },
    "exceptions": {
      "history": [
        {
          "from": "0002-01-01",
          "year": {
            "type": "fixed_date",
            "start": {
              "month": 1,
              "day": 1
            }
          },
          "subdivision": {
            "type": "calendar_months",
            "month_start_day": 1,
            "quarters": [
              4,
              4,
              4
            ]
          }
        }
      ]
    }
  },
