{
  "name": "table-week-based-narrowed-numbering",
  "description": "ILLUSTRATIVE: the ISO 8601 week-year anchor (Monday nearest 1 January) numbered by 'start', which collides over the whole supported range (the years starting 2018-01-01 and 2018-12-31 both get 2018), with a table subdivision of two invented half-years per year for the ISO years 2016 to 2018, which all start in January. Year numbering runs only over the years the table covers, so 2016, 2017 and 2018 are consecutive and the definition is valid.",
  "source": {
    "kind": "oracle",
    "citation": "Independent implementation of the spec in conformance/generators/fiscal_oracle.py, written with Python datetime and no fiscalclock code",
    "url": null,
    "checked_by": "fiscal_oracle.py: Calendar.seq narrowed to the table's years; the table cross-block checks and naming_errors pass"
  },
  "definition": {
    "spec_version": 1,
    "year": {
      "type": "week_based",
      "anchor": {
        "edge": "start",
        "month": 1,
        "day": 1,
        "rule": "nearest"
      }
    },
    "week": {
      "starts_on": "monday",
      "numbering": "contains_start"
    },
    "subdivision": {
      "type": "table",
      "boundaries": [
        "2016-01-04",
        "2016-07-04",
        "2017-01-02",
        "2017-07-03",
        "2018-01-01",
        "2018-07-02",
        "2018-12-31"
      ],
      "quarters": [
        1,
        1
      ]
    },
    "naming": {
      "default": "fy",
      "schemes": {
        "fy": {
          "year_number": "start",
          "templates": {
            "year": "FY{yyyy}",
            "period": "FY{yyyy} P{pp}"
          }
        }
      }
    }
  },
