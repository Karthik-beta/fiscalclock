{
  "name": "fiscalclock-website",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "sync": "node scripts/sync.mjs",
    "predev": "npm run sync",
    "dev": "astro dev",
    "prebuild": "npm run sync",
    "build": "astro build",
    "precheck": "npm run sync",
    "check": "astro check",
    "preview": "astro preview",
    "test": "node --test \"tests/unit/*.test.ts\" && playwright test --project=checks",
    "shots": "playwright test --project=shots"
  },
  "dependencies": {
    "@astrojs/starlight": "0.42.8",
    "astro": "7.4.4",
    "starlight-llms-txt": "0.12.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@ibm/plex-mono": "2.5.0",
    "@ibm/plex-sans": "1.1.0",
    "@playwright/test": "1.64.1",
    "@types/mdast": "4.0.4",
    "mdast-util-mdx-jsx": "3.2.0",
    "remark-gfm": "4.0.1",
    "remark-mdx": "3.1.1",
    "remark-parse": "11.0.0",
    "remark-stringify": "11.0.0",
    "typescript": "6.0.3",
    "unified": "11.0.5"
  },
  "allowScripts": {
    "@ibm/plex-mono": false,
    "@ibm/plex-sans": false
  }
}
